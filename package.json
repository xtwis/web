{
  "name": "@xtwis/web",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "description": "xtwis documentation site — Twisuki's open-source toolkit.",
  "author": "Twisuki",
  "license": "MIT",
  "publishConfig": {
    "access": "private"
  },
  "homepage": "https://github.com/xtwis/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtwis/web.git"
  },
  "bugs": {
    "url": "https://github.com/xtwis/web/issues"
  },
  "keywords": [
    "xtwis",
    "docs",
    "documentation",
    "vitepress"
  ],
  "scripts": {
    "sync": "node --env-file-if-exists=.env scripts/sync/index.mjs",
    "dev": "pnpm run sync && vitepress dev",
    "build": "pnpm run sync && vitepress build",
    "preview": "pnpm run sync && vitepress preview",
    "lint": "eslint",
    "fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4"
  }
}
