{
  "framework": "vitepress",
  "buildCommand": "pnpm build:sync",
  "outputDirectory": ".vitepress/dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
